# Creating a case needs all five vars below (see README.md for how to get
# each one). DATABASE_URL is the only optional one.

# --- Database (optional) ---
# Unset: uses an embedded PGLite (Postgres-in-WASM) instance, zero config.
# Set: connects to a real Postgres/Neon instance instead.
# DATABASE_URL=postgres://user:password@host/db

# --- GenLayer Studio (studionet — hosted, gasless, no faucet needed) ---
# The deployed MeridianAdjudicator / SettlementOutbox addresses, and the
# server-only key that signs calls to them (never sent to the browser; never
# needs funds — Studio is gasless). See README.md "Deploying the GenLayer
# contracts".
VITE_MERIDIAN_ADJUDICATOR=0x...
VITE_MERIDIAN_OUTBOX=0x...
GENLAYER_DEPLOYER_KEY=0x...

# --- Vault on Arc Testnet ---
# The deployed Vault.sol address, and the server-only relayer key allowed to
# call settle() on it. VAULT_DEPLOYER_KEY is only needed once, to run
# scripts/deploy-vault.mjs — it does not need to stay in this file
# afterward, but VAULT_RELAYER_KEY must remain (the app calls settle() with
# it every time a case is relayed). See README.md "Deploying the vault".
VITE_VAULT_ADDRESS=0x...
VAULT_DEPLOYER_KEY=0x...
VAULT_RELAYER_KEY=0x...
